# ---- Required ----
# MongoDB connection string (Atlas recommended: it is a replica set, so credit mutations also run in transactions)
MONGODB_URI=
# Random string, 32+ chars. Generate with: openssl rand -base64 48
AUTH_SECRET=
# Public site URL, no trailing slash (used for canonical URLs, sitemap, OG tags, checkout redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- AI image generation (Gemini) ----
GEMINI_API_KEY=
# Any Gemini model that can return images
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---- Payments (Stripe Checkout; provider is abstracted in src/lib/payments) ----
PAYMENT_PROVIDER=stripe
# Stripe secret key (sk_live_... / sk_test_...)
PAYMENT_SECRET=
# Stripe webhook signing secret (whsec_...) for POST /api/payments/webhook
PAYMENT_WEBHOOK_SECRET=

# ---- Image storage ----
# Generated images are saved on local disk under this folder (served through /api/files/*)
LOCAL_STORAGE_DIR=public/generated

# ---- Email (password reset, contact form). Without a key, links are printed to the server console in dev ----
RESEND_API_KEY=
EMAIL_FROM=TattooGenerator <noreply@tattoogenerator.com>
